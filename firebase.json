{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": ["firebase.json", "database.rules.json", "README.md", "**/.*", "tools/**", "php-version/**", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(js|css|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  },
  "database": { "rules": "database.rules.json" }
}
